# Copy to .env and fill in. Never commit the real .env.

PORT=4000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

# Auth
JWT_SECRET=replace-with-a-long-random-string
SELLER_EMAIL=seller@example.com
SELLER_PASSWORD=replace-me

# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Extra allowed CORS origins, comma separated (localhost:5173 is always allowed)
CLIENT_ORIGINS=https://your-frontend.vercel.app

# --- AI / ML tuning (optional, sensible defaults in code) ---
# How long a trained recommender is cached before it refits
ML_MODEL_TTL_MS=300000
# How much order history feeds the collaborative filtering signal
ML_ORDER_LOOKBACK_DAYS=90
